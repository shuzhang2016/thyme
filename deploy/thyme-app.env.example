# /etc/thyme/thyme-app.env
#
# This file is read both by systemd (EnvironmentFile=, plain KEY=VALUE, no
# shell expansion) and by the SysV/BusyBox init script (sourced by /bin/sh).
# Keep it to the common subset: no `export`, no command substitution, no
# unquoted spaces. It is installed as 0644 and is not a secret store.

# Supervisor executable (the downstream thyme app that drives
# MpSupervisorSession::Prepare/ForkRoles/PollRestarts).
THYME_APP_BIN=/opt/usr/thyme/bin/thyme-app

# OPS-10 read-only JSON status endpoint. Must live in RuntimeDirectory=thyme
# (/run/thyme) so systemd creates it with the service's ownership. `none`
# disables it.
THYME_STATUS_SOCKET=/run/thyme/status.sock

# send READY=1 / WATCHDOG=1 to systemd. Requires Type=notify and a
# supervisor entrypoint that calls ForkRoles()/PollRestarts(). The systemd unit
# already sets this; the SysV script ignores it (no NOTIFY_SOCKET).
THYME_SD_NOTIFY=1

# Optional: file logging for the SysV/BusyBox path (no journald there).
# The SysV script defaults this to /var/log/thyme/app.log when unset.
# THYME_LOG_FILE=/var/log/thyme/app.log

# Optional: account used by the SysV script (systemd uses User=/Group=).
# THYME_USER=thyme
# THYME_GROUP=thyme
