# OPS-11: /etc/thyme/thyme-trigger-center.env
#
# Read by systemd through EnvironmentFile= (plain KEY=VALUE, no shell
# expansion). The matching unit is deploy/systemd/thyme-trigger-center.service.
# Like thyme-app.env this file is not a secret store; it is installed 0644.

# OPS-11: send READY=1 after the recorder attached its sources and both
# sockets are bound, then WATCHDOG=1 at most once per second. Must stay 1 for
# the unit's Type=notify/WatchdogSec; set 0 only together with a drop-in that
# switches the unit to Type=simple and WatchdogSec=0.
THYME_SD_NOTIFY=1

# OPS-07 host-capacity policy applied by `--check-resources` and again at
# startup after the recorder created its output directory:
#   enforce (default) -> exit 3 when RLIMIT_NOFILE, /dev/shm or the output
#                        disk cannot meet the configured plan;
#   warn              -> log and start anyway;
#   off               -> skip the check.
# THYME_RESOURCE_CHECK=enforce

# Optional recalibration of the OPS-07 plan (defaults documented in
# docs/runbook.md §7). Keep these in sync with the deployment's channel count.
# THYME_RESOURCE_BASELINE_FILES=64
# THYME_RESOURCE_FILES_PER_CHANNEL=2
# THYME_RESOURCE_SHM_PLANNED_MB=8
# THYME_RESOURCE_SHM_RESERVE_MB=16
# THYME_RESOURCE_MEMLOCK_HEADROOM_MB=64
