function(expect_contains file needle)
  file(READ "${file}" body)
  string(FIND "${body}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "sharded golden: ${file} missing: ${needle}")
  endif()
endfunction()

function(expect_count file needle expected)
  file(READ "${file}" body)
  string(REGEX MATCHALL "${needle}" matches "${body}")
  list(LENGTH matches count)
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "sharded golden: ${file} has ${count} of ${needle}, expected ${expected}")
  endif()
endfunction()

