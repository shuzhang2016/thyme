# Real SP execution: independent objects, concurrent callbacks, serial shards,
# exactly-once delivery on every edge. Static test state is explicitly atomic.
file(WRITE "${ROOT}/src/nodes/prod.h" [==[#pragma once
#include "generated/prod_generated.h"
class ProducerThread final : public ProducerThreadGenerated {
 public:
  using ProducerThreadGenerated::ProducerThreadGenerated;
 protected:
  bool OnTick(const TickIn&, TickOut*) override { return false; }
};
]==])
file(WRITE "${ROOT}/src/nodes/prod.cpp" "#include \"nodes/prod.h\"\n")
file(WRITE "${ROOT}/src/nodes/shard_test.h" [==[#pragma once
#include <atomic>
#include <chrono>
#include <cstdint>
#include <thread>

namespace shard_test {
inline std::atomic<uint32_t> active{0};
inline std::atomic<uint32_t> max_active{0};
inline std::atomic<uint32_t> serial_violations{0};
inline std::atomic<uint32_t> arrived{0};
inline std::atomic<bool> release{false};
inline std::atomic<uint32_t> counts[2][4]{};
inline std::atomic_flag running[2] = {ATOMIC_FLAG_INIT, ATOMIC_FLAG_INIT};

inline void Handle(uint32_t shard, uint32_t channel) {
  if (running[shard].test_and_set(std::memory_order_acquire)) {
    serial_violations.fetch_add(1, std::memory_order_relaxed);
  }
  const uint32_t now = active.fetch_add(1, std::memory_order_acq_rel) + 1;
  uint32_t high = max_active.load(std::memory_order_relaxed);
  while (high < now && !max_active.compare_exchange_weak(high, now)) {
  }
  counts[shard][channel].fetch_add(1, std::memory_order_relaxed);
  if (arrived.fetch_add(1, std::memory_order_acq_rel) == 1) {
    release.store(true, std::memory_order_release);
  }
  while (!release.load(std::memory_order_acquire)) {
    std::this_thread::yield();
  }
  std::this_thread::sleep_for(std::chrono::milliseconds(1));
  active.fetch_sub(1, std::memory_order_acq_rel);
  running[shard].clear(std::memory_order_release);
}
}  // namespace shard_test
]==])
foreach(shard 0 1)
  if(shard EQUAL 0)
    set(channels "C0" "C2")
    set(indices "0" "2")
  else()
    set(channels "C1" "C3")
    set(indices "1" "3")
  endif()
  list(GET channels 0 ca)
  list(GET channels 1 cb)
  list(GET indices 0 ia)
  list(GET indices 1 ib)
  file(WRITE "${ROOT}/src/nodes/sink__s${shard}.h" "#pragma once\n#include \"generated/sink__s${shard}_generated.h\"\nclass SinkS${shard}Thread final : public SinkS${shard}ThreadGenerated {\n public:\n  using SinkS${shard}ThreadGenerated::SinkS${shard}ThreadGenerated;\n protected:\n  void On${ca}(const decltype(c${ia}_)::Sample&) override;\n  void On${cb}(const decltype(c${ib}_)::Sample&) override;\n};\n")
  file(WRITE "${ROOT}/src/nodes/sink__s${shard}.cpp" "#include \"nodes/sink__s${shard}.h\"\n#include \"nodes/shard_test.h\"\nvoid SinkS${shard}Thread::On${ca}(const decltype(c${ia}_)::Sample&) { shard_test::Handle(${shard}, ${ia}); }\nvoid SinkS${shard}Thread::On${cb}(const decltype(c${ib}_)::Sample&) { shard_test::Handle(${shard}, ${ib}); }\n")
endforeach()
file(WRITE "${ROOT}/src/main.cpp" [==[#include "generated/wiring.h"
#include "nodes/shard_test.h"
#include <chrono>
#include <cstdint>
#include <string>
#include <thread>

int main() {
  auto p = Pipeline::Create();
  if (static_cast<const void*>(&p->sink__s0) ==
      static_cast<const void*>(&p->sink__s1)) return 1;
  if (std::string(p->sink__s0.name()) != "sink__s0") return 2;
  if (std::string(p->sink__s1.name()) != "sink__s1") return 3;
  p->Start();
  thyme::NotifPipe<thyme::Frame<Reading>, 8>* pipes[4] = {
      &p->event_transports_.sink__s0_c0_pipe,
      &p->event_transports_.sink__s1_c1_pipe,
      &p->event_transports_.sink__s0_c2_pipe,
      &p->event_transports_.sink__s1_c3_pipe};
  for (uint32_t sequence = 1; sequence <= 8; ++sequence) {
    for (uint32_t channel = 0; channel < 4; ++channel) {
      thyme::Frame<Reading> frame{};
      thyme::FrameInit(frame, sequence, 0, 0);
      frame.payload.value = static_cast<int32_t>(sequence);
      thyme::FrameSeal(frame, 0, 0);
      while (!pipes[channel]->Push(frame)) {
        std::this_thread::yield();
      }
    }
  }
  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
  uint32_t total = 0;
  while (std::chrono::steady_clock::now() < deadline) {
    total = 0;
    for (uint32_t shard = 0; shard < 2; ++shard) {
      for (uint32_t channel = 0; channel < 4; ++channel) {
        total += shard_test::counts[shard][channel].load();
      }
    }
    if (total == 32) break;
    std::this_thread::sleep_for(std::chrono::milliseconds(2));
  }
  p->RequestStop();
  p->Join();
  if (total != 32) return 4;
  for (uint32_t shard = 0; shard < 2; ++shard) {
    for (uint32_t channel = 0; channel < 4; ++channel) {
      const uint32_t expected = channel % 2 == shard ? 8 : 0;
      if (shard_test::counts[shard][channel].load() != expected) return 5;
    }
  }
  if (shard_test::max_active.load() < 2) return 6;
  if (shard_test::serial_violations.load() != 0) return 7;
  if (p->sink__s0.handled_count() != 16) return 8;
  if (p->sink__s1.handled_count() != 16) return 9;
  if (p->sink__s0.overrun_degrade_actions() == 0) return 10;
  if (p->sink__s1.overrun_degrade_actions() == 0) return 11;
  if (p->sink__s0.cb_work().count() != 16) return 12;
  if (p->sink__s1.cb_work().count() != 16) return 13;
  return 0;
}
]==])

