# Generation-time rejection matrix.
function(expect_reject name yaml needle)
  set(input "${CMAKE_BINARY_DIR}/sharded_reject_${name}.yaml")
  file(WRITE "${input}" "${yaml}")
  execute_process(COMMAND "${GEN}" --in "${input}" --out
    "${CMAKE_BINARY_DIR}/sharded_reject_${name}" --update generated
    --template-dir "${TPL}" --no-health-reporter
    RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 2)
    message(FATAL_ERROR "${name}: expected exit 2, got ${rc}")
  endif()
  string(FIND "${err}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "${name}: missing '${needle}':\n${err}")
  endif()
endfunction()

